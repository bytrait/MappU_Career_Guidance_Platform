generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
  url      = env("BILLING_DATABASE_URL")
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum CreditTransactionType {
  PURCHASE
  CONSUME
  REFUND
  SIGNUP_BONUS
}

enum RegistrationPricingType {
  INDIVIDUAL
  SCHOOL
}

enum StudentPaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  FREE
  WAIVED
}

model PaymentOrder {
  id                String        @id @default(uuid())
  counsellorId      String
  razorpayOrderId   String        @unique
  studentCount      Int
  pricePerStudent   Int
  totalAmount       Int
  status            PaymentStatus @default(PENDING)

  razorpayPaymentId String?
  failureReason     String?

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@index([counsellorId])
  @@index([status])
}

model CounsellorCredit {
  id            String   @id @default(uuid())
  counsellorId  String   @unique
  totalCredits  Int      @default(0)
  usedCredits   Int      @default(0)

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([counsellorId])
}

model PaymentWebhookLog {
  id        String   @id @default(uuid())
  eventType String
  payload   Json
  createdAt DateTime @default(now())

  @@index([eventType])
}

model CreditTransaction {
  id            String                  @id @default(uuid())
  counsellorId  String
  type          CreditTransactionType
  amount        Int
  referenceId   String?
  description   String?

  createdAt     DateTime                @default(now())

  @@index([counsellorId])
  @@index([type])
  @@index([createdAt])
}

// @deprecated Legacy per-counsellor defaults — not used for new signups when referenceCode/referenceCodeId is set.
model CounsellorPricingConfig {
  id               String          @id @default(uuid())
  counsellorId     String          @unique

  paymentEnabled   Boolean         @default(true)
  individualPrice  Int?

  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  schoolPrices     SchoolPricing[]
}

// @deprecated Legacy school-level pricing — use ReferenceTokenPrice (auth reference tokens) for new flows.
model SchoolPricing {
  id               String                     @id @default(uuid())

  pricingConfigId  String
  pricingConfig    CounsellorPricingConfig   @relation(fields: [pricingConfigId], references: [id], onDelete: Cascade)

  counsellorId     String
  schoolId         String
  schoolName       String

  amount           Int
  isActive         Boolean                    @default(true)

  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@index([pricingConfigId])
  @@index([counsellorId])
  @@index([schoolId])
  @@index([isActive])
}

// Price per auth reference token. Canonical key: tokenId (= auth ReferenceCode.id / referenceTokenId).
model ReferenceTokenPrice {
  id            String    @id @default(uuid())
  tokenId       String    @unique // auth referenceTokenId
  code          String    @unique
  counsellorId  String
  type          String
  targetId      String
  amount        Int
  currency      String    @default("INR")
  label         String?
  startDate     DateTime?
  expiryDate    DateTime?
  isActive      Boolean   @default(true)

  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([counsellorId])
  @@index([code])
  @@index([isActive])
}

model StudentPayment {
  id                  String                  @id @default(uuid())

  studentId           String                  @unique
  counsellorId        String

  registrationType    RegistrationPricingType

  schoolId            String?
  schoolName          String?

  referenceCode       String?
  referenceCodeId     String?

  amount              Int
  currency            String                  @default("INR")

  status              StudentPaymentStatus    @default(PENDING)

  razorpayOrderId     String?                 @unique
  razorpayPaymentId   String?
  razorpaySignature   String?

  receiptNumber       String?                 @unique
  receiptSent         Boolean                 @default(false)
  receiptSentAt       DateTime?

  failureReason       String?

  paidAt              DateTime?

  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt

  @@index([studentId])
  @@index([counsellorId])
  @@index([registrationType])
  @@index([status])
  @@index([schoolId])
  @@index([createdAt])
  @@index([receiptNumber])
  @@index([receiptSent])
  @@index([referenceCode])
  @@index([referenceCodeId])
}